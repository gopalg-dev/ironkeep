# dependencies
node_modules/

# local agent configuration and skills
/.claude/
/.codex/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Salesforce tooling scratch folder (rewritten constantly; never ours)
.sf/

# Native module build output (Gradle), never committed
modules/*/android/build/
modules/*/android/.gradle/
**/.gradle/

# Local device/test captures; canonical design reference images remain tracked
/e2e/screenshots/
/docs/design/screens/report-sharing/
