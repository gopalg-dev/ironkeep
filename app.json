{
  "expo": {
    "name": "IronKeep",
    "slug": "ironkeep",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/branding/fold/launcher.png",
    "scheme": "ironkeep",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.ironkeep",
      "blockedPermissions": ["android.permission.INTERNET", "android.permission.SYSTEM_ALERT_WINDOW"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/fold/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/fold/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/fold/symbol.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Barlow-Regular.ttf",
            "./assets/fonts/Barlow-Medium.ttf",
            "./assets/fonts/Barlow-SemiBold.ttf",
            "./assets/fonts/Barlow-Bold.ttf",
            "./assets/fonts/Barlow-ExtraBold.ttf",
            "./assets/fonts/BarlowCondensed-Medium.ttf",
            "./assets/fonts/BarlowCondensed-SemiBold.ttf",
            "./assets/fonts/BarlowCondensed-Bold.ttf"
          ]
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-mail-composer",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "gifEnabled": false
          }
        }
      ],
      "./plugins/with-release-hardening",
      "./plugins/with-notification-icon"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "adfdf8fc-47b5-47dc-ad02-201be4d4691c"
      }
    },
    "owner": "gopal262000"
  }
}
