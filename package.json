{
  "name": "ironkeep",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "check": "tsc --noEmit && tsc -p scripts && biome ci . --diagnostic-level=info && bun scripts/check-colors.ts && bun scripts/check-contrast.ts",
    "check:fix": "biome check --write .",
    "test": "jest",
    "doctor": "expo-doctor",
    "release:check": "bun scripts/release-check.ts",
    "design:tokens": "bun scripts/design-tokens-board.ts"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.2.1",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-mail-composer": "~58.0.3",
    "expo-router": "~58.0.24",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uniwind": "^1.13.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@jest/globals": "^30.5.2",
    "@react-native/jest-preset": "0.88.0",
    "@types/bun": "latest",
    "@types/node": "24",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.11",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ]
  }
}
