<resources>
  <!-- System notification typography and colours follow the shade, independently of the app's look. -->
  <style name="SessionNotificationButton" parent="android:style/Widget.Material.Button.Borderless">
    <item name="android:layout_height">48dp</item>
    <item name="android:minWidth">48dp</item>
    <item name="android:minHeight">48dp</item>
    <item name="android:padding">0dp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textAppearance">@style/TextAppearance.Compat.Notification</item>
    <item name="android:maxLines">1</item>
    <item name="android:ellipsize">end</item>
  </style>
</resources>
