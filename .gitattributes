# Normalize all text files to LF in the repo and on checkout, on every platform.
# This keeps Biome (which wants LF) green regardless of a clone's core.autocrlf.
* text=auto eol=lf

# Binary files: never touch their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.bin binary
*.xlsx binary
*.xls binary
*.pdf binary
*.zip binary
*.jar binary
*.keystore binary
*.jks binary
*.mp4 binary
